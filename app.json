{
  "expo": {
    "name": "Buildr",
    "slug": "buildr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "buildr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/f49b7b76-5a25-494b-a19b-91e7712198e4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "electrix67",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.getbuildr.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Nous avons besoin d'accéder à vos photos pour les ajouter aux chantiers.",
        "NSCameraUsageDescription": "Nous avons besoin de la caméra pour prendre des photos de chantier.",
        "NSLocationWhenInUseUsageDescription": "Nous avons besoin de votre position pour localiser les chantiers.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.getbuildr.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#1C1917"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "backgroundColor": "#1C1917",
          "resizeMode": "contain",
          "imageWidth": 300
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Accéder aux photos pour les ajouter aux chantiers.",
          "cameraPermission": "Prendre des photos de chantier.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Localiser les chantiers à proximité."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#D97706",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f49b7b76-5a25-494b-a19b-91e7712198e4"
      }
    }
  }
}
